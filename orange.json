{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0A0A14",
    "bgPanel": "#12111F",
    "bgElement": "#1E1B2E",
    "fg": "#FFE8D6",
    "fgMuted": "#B8A0A0",
    "fgSubtle": "#7A6E85",
    "orange": "#FF3B1F",
    "orangeGlow": "#FF6B35",
    "orangeSoft": "#FF8A5C",
    "orangeDeep": "#CC2A12",
    "amber": "#FFCA28",
    "red": "#FF1A1A",
    "green": "#00E676",
    "blue": "#2979FF",
    "keyword": "#FF6B9D",
    "function": "#2979FF",
    "string": "#00E676",
    "number": "#FF6B35",
    "type": "#FFCA28",
    "operator": "#00E5FF",
    "comment": "#6B6580",
    "border": "#2A1F35",
    "borderActive": "#FF3B1F",
    "borderSubtle": "#1A1828"
  },
  "theme": {
    "primary": { "dark": "orange", "light": "orangeDeep" },
    "secondary": { "dark": "orangeSoft", "light": "orangeDeep" },
    "accent": { "dark": "orangeGlow", "light": "orange" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "fgMuted", "light": "fgSubtle" },
    "background": { "dark": "bg", "light": "#FFF0E6" },
    "backgroundPanel": { "dark": "bgPanel", "light": "#FFE0CC" },
    "backgroundElement": { "dark": "bgElement", "light": "#FFD1B8" },
    "border": { "dark": "border", "light": "#E8B49A" },
    "borderActive": { "dark": "borderActive", "light": "orangeDeep" },
    "borderSubtle": { "dark": "borderSubtle", "light": "#E8B49A" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fgMuted", "light": "fgSubtle" },
    "diffHunkHeader": { "dark": "fgMuted", "light": "fgSubtle" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "#0F2A1A", "light": "#D1FAE5" },
    "diffRemovedBg": { "dark": "#2A0F0F", "light": "#FEE2E2" },
    "diffContextBg": { "dark": "bgPanel", "light": "#FFF0E6" },
    "diffLineNumber": { "dark": "fgSubtle", "light": "fgMuted" },
    "diffAddedLineNumberBg": { "dark": "#0F2A1A", "light": "#D1FAE5" },
    "diffRemovedLineNumberBg": { "dark": "#2A0F0F", "light": "#FEE2E2" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "orange", "light": "orangeDeep" },
    "markdownLink": { "dark": "operator", "light": "orangeDeep" },
    "markdownLinkText": { "dark": "orangeGlow", "light": "orange" },
    "markdownCode": { "dark": "type", "light": "orangeDeep" },
    "markdownBlockQuote": { "dark": "comment", "light": "fgSubtle" },
    "markdownEmph": { "dark": "string", "light": "orangeDeep" },
    "markdownStrong": { "dark": "orange", "light": "orangeDeep" },
    "markdownHorizontalRule": { "dark": "border", "light": "#E8B49A" },
    "markdownListItem": { "dark": "orangeGlow", "light": "orangeDeep" },
    "markdownListEnumeration": { "dark": "type", "light": "orangeDeep" },
    "markdownImage": { "dark": "function", "light": "orangeDeep" },
    "markdownImageText": { "dark": "fgMuted", "light": "fgSubtle" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "comment", "light": "#6B6580" },
    "syntaxKeyword": { "dark": "keyword", "light": "#C2185B" },
    "syntaxFunction": { "dark": "function", "light": "#1565C0" },
    "syntaxVariable": { "dark": "fg", "light": "bg" },
    "syntaxString": { "dark": "string", "light": "#2E7D32" },
    "syntaxNumber": { "dark": "number", "light": "#CC2A12" },
    "syntaxType": { "dark": "type", "light": "#8A6B1A" },
    "syntaxOperator": { "dark": "operator", "light": "#006064" },
    "syntaxPunctuation": { "dark": "fgMuted", "light": "fgSubtle" }
  }
}
